{
  "name": "pr-lens",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "app:bundle": "next build && node scripts/bundle-server.mjs && node scripts/bundle-gantry.mjs",
    "app:start": "npm run app:bundle && electron .",
    "app:build": "node scripts/clean-dist.mjs && npm run app:bundle && electron-builder --dir",
    "app:install": "npm run app:build && rm -rf \"/Applications/Gantry.app\" && cp -R \"dist/mac-arm64/Gantry.app\" /Applications/",
    "app:build:win": "node scripts/clean-dist.mjs && npm run app:bundle && electron-builder --win nsis",
    "app:build:linux": "node scripts/clean-dist.mjs && npm run app:bundle && electron-builder --linux AppImage"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "cross-spawn": "7.0.6",
    "lucide-react": "^1.57.0",
    "mermaid": "^11.17.2",
    "next": "16.4.1",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.5",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.5",
    "shiki": "^4.5.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "main": "electron/main.cjs",
  "productName": "Gantry",
  "build": {
    "appId": "dev.prlens.app",
    "productName": "Gantry",
    "directories": {
      "output": "dist",
      "buildResources": "electron"
    },
    "files": [
      "electron/main.cjs",
      "electron/preload.cjs",
      "package.json",
      "!node_modules/**/*"
    ],
    "mac": {
      "target": "dir",
      "category": "public.app-category.developer-tools",
      "icon": "electron/icon.png",
      "identity": null,
      "darkModeSupport": true
    },
    "asar": true,
    "afterPack": "electron/after-pack.cjs",
    "protocols": [
      {
        "name": "Gantry review",
        "schemes": [
          "pr-lens"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Development",
      "icon": "electron/icon.png",
      "artifactName": "Gantry-x86_64.${ext}"
    }
  }
}
