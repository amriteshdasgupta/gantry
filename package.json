{
  "name": "gantry-monorepo",
  "private": true,
  "version": "0.1.1",
  "description": "Gantry \u2014 a local development control plane for tickets, Git worktrees, previews, and AI coding agents",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b packages/shared packages/server packages/cli && npm run build --workspace @gantry/ui",
    "dev:server": "npm run dev --workspace @gantry/server",
    "dev:ui": "npm run dev --workspace @gantry/ui",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint packages scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b packages/shared packages/server packages/cli && tsc --noEmit -p packages/ui",
    "release:pack": "node scripts/pack-release.mjs",
    "release:verify": "node scripts/check-release.mjs",
    "desktop:setup": "npm ci --prefix desktop",
    "desktop:dev": "npm run dev --prefix desktop",
    "desktop:build": "npm run build && npm run app:build --prefix desktop",
    "desktop:start": "npm run build && npm run app:start --prefix desktop",
    "desktop:restart": "node scripts/restart-desktop.js",
    "desktop:test": "npm run test:e2e --prefix desktop"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.4.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "fastify": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yaml": "^2.6.0",
    "zod": "^3.24.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
